{
  "manifest_version": 2,
  "name": "GeckoStealth",
  "version": "1.0.0",
  "description": "Native Gecko Stealth Extension for Firefox Automation",
  "permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "stealth.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
